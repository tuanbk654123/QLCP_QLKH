crm.anneco.vn {

	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy backend:8080
	}

	@minio path /minio/*
	handle @minio {
		uri strip_prefix /minio
		reverse_proxy minio:9000
	}

	@minioConsole path /minio-console/*
	handle @minioConsole {
		uri strip_prefix /minio-console
		reverse_proxy minio:9001
	}

	handle {
		reverse_proxy frontend:80
	}
}
